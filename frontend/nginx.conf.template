server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # config.js nasce na partida do contêiner: não pode ficar preso em cache.
    location = /config.js {
        add_header Cache-Control "no-store";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # /api/qualquer-coisa  ->  back-end /qualquer-coisa  (mesmo domínio: dispensa CORS).
    # O endereço do back-end é uma variável para o nginx subir mesmo que ele ainda não exista.
    location /api/ {
        resolver ${NGINX_RESOLVER} valid=10s;
        set $upstream ${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
