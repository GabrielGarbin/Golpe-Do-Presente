+/**
+ * Contrato front ↔ back, conferido no código-fonte (não precisa subir nada):
+ *  - toda rota chamada em frontend/js/api.js existe num controller Java, com o mesmo método HTTP;
+ *  - os campos que o front envia na denúncia existem no DenunciaRequest;
+ *  - os canais do <select> do front existem no enum CanalContato.
+ */
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync, readdirSync, statSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+
+const RAIZ = fileURLToPath(new URL('../../', import.meta.url));
+const JAVA = RAIZ + 'backend/src/main/java/com/Presente/A3/';
+const ler = p => readFileSync(p, 'utf8');
+
+function arquivosJava(dir) {
+  return readdirSync(dir).flatMap(n => {
+    const p = dir + n;
+    return statSync(p).isDirectory() ? arquivosJava(p + '/') : p.endsWith('.java') ? [p] : [];
+  });
+}
+
+/** Rotas do back: "GET /denuncias/estatisticas", "GET /golpistas/{id}"... */
+function rotasDoBack() {
+  const rotas = new Set();
+  for (const arq of arquivosJava(JAVA)) {
+    const src = ler(arq);
+    if (!/@RestController/.test(src)) continue;
+    const base = (src.match(/@RequestMapping\(\s*"([^"]*)"\s*\)/) || [, ''])[1];
+    for (const m of src.matchAll(/@(Get|Post|Put|Delete)Mapping(?:\(\s*"([^"]*)"\s*\))?/g)) {
+      rotas.add(`${m[1].toUpperCase()} ${base}${m[2] || ''}`);
+    }
+  }
+  return rotas;
+}
+
+/** Rotas do front: lê as chamadas request('/caminho', { method: 'POST' }) de api.js. */
+function rotasDoFront() {
+  const src = ler(RAIZ + 'frontend/js/api.js');
+  const chamadas = [];
+  for (const m of src.matchAll(/request\(\s*'([^'?]+)[^']*'(?:\s*\+[^,)]*)?(?:,\s*\{([^}]*)\})?/g)) {
+    const metodo = (m[2]?.match(/method:\s*'(\w+)'/) || [, 'GET'])[1];
+    chamadas.push(`${metodo} ${m[1]}`);
+  }
+  return chamadas;
+}
+
+test('toda rota usada pelo front existe no back-end com o mesmo método', () => {
+  const back = rotasDoBack();
+  const front = rotasDoFront();
+  assert.ok(front.length >= 10, 'encontrou as chamadas de api.js: ' + front.join(', '));
+  const faltando = front.filter(r => !back.has(r));
+  assert.deepEqual(faltando, [], 'rotas do front sem endpoint no back');
+});
+
+test('campos enviados pela aba Denunciar existem no DenunciaRequest do back', () => {
+  const dto = ler(JAVA + 'Dto/DenunciaRequest.java');
+  const view = ler(RAIZ + 'frontend/js/views/denunciar.js');
+  const corpo = view.match(/Api\.denunciar\(\{([\s\S]*?)\}\)/)[1];
+  const campos = [...corpo.matchAll(/(\w+):/g)].map(m => m[1]);
+  assert.deepEqual(campos.sort(), ['canal', 'descricao', 'estabelecimentoFalsificado', 'telefoneGolpista']);
+  for (const c of campos) assert.match(dto, new RegExp(`private \\w+ ${c};`), `DenunciaRequest.${c}`);
+});
+
+test('canais do formulário existem no enum CanalContato', () => {
+  const enumJava = ler(JAVA + 'Modelo/CanalContato.java');
+  const html = ler(RAIZ + 'frontend/index.html');
+  const select = html.match(/<select id="dCanal">([\s\S]*?)<\/select>/)[1];
+  const canais = [...select.matchAll(/value="(\w+)"/g)].map(m => m[1]);
+  assert.ok(canais.length > 0);
+  for (const c of canais) assert.match(enumJava, new RegExp(`\\b${c}\\b`), `CanalContato.${c}`);
+});
+
+test('a descrição respeita o limite de 500 caracteres da coluna no banco', () => {
+  const modelo = ler(JAVA + 'Modelo/Denuncia.java');
+  assert.match(modelo, /@Column\(length = 500\)\s*private String descricao;/);
+  assert.match(ler(RAIZ + 'frontend/index.html'), /id="dDesc" maxlength="500"/);
+  assert.match(ler(RAIZ + 'frontend/js/views/denunciar.js'), /desc\.length > 500/);
+});
diff --git a/tests/e2e/fluxo-denuncia.test.mjs b/tests/e2e/fluxo-denuncia.test.mjs
new file mode 100644
index 0000000..55504f3
--- /dev/null
+++ b/tests/e2e/fluxo-denuncia.test.mjs
@@ -0,0 +1,77 @@
+/**
+ * Teste ponta a ponta contra uma API DE VERDADE rodando (com o banco ligado).
+ *
+ * Usa o próprio frontend/js/api.js (o mesmo código que roda no navegador) para:
+ *   1. criar uma conta;  2. enviar uma denúncia;  3. ver o risco do número subir;
+ *   4. (com credenciais de admin) ler a denúncia de volta e confirmar que foi gravada.
+ *
+ * Como rodar (com o back-end já rodando):
+ *   API_URL=http://localhost:8081 npm run e2e
+ *   API_URL=http://localhost:8081 ADMIN_EMAIL=admin@x.com ADMIN_SENHA=... npm run e2e
+ *
+ * ATENÇÃO: grava dados reais (uma conta e uma denúncia de teste) no banco
+ * apontado pela API. Prefira um banco de desenvolvimento, não o de produção.
+ */
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { frontModule } from '../helpers/dom.mjs';
+
+const API_URL = process.env.API_URL;
+const pular = !API_URL && 'defina API_URL (ex.: http://localhost:8081) com o back-end rodando';
+
+// Ambiente mínimo de navegador para api.js: config e localStorage.
+const guardado = new Map();
+globalThis.window = Object.assign(new EventTarget(), { APP_CONFIG: { API_URL, TIMEOUT_MS: 20000 } });
+globalThis.location = new URL('http://localhost:5500/');
+globalThis.localStorage = {
+  getItem: k => (guardado.has(k) ? guardado.get(k) : null),
+  setItem: (k, v) => guardado.set(k, String(v)),
+  removeItem: k => guardado.delete(k)
+};
+
+const { Api } = pular ? {} : await import(frontModule('js/api.js'));
+const aleatorio = (n = 8) => String(Math.floor(Math.random() * 10 ** n)).padStart(n, '0');
+const golpista = '119' + aleatorio();
+const relato = `Teste automatizado e2e ${new Date().toISOString()}`;
+let idDenuncia;
+
+test('API responde (indicador "API conectada" do front)', { skip: pular }, async () => {
+  const camadas = await Api.ping();
+  assert.equal(typeof camadas, 'object');
+});
+
+test('cadastro + denúncia são aceitos pela API', { skip: pular }, async () => {
+  const reg = await Api.registrar({
+    nome: 'Teste E2E', email: `e2e${Date.now()}${aleatorio(4)}@teste.com`, telefone: '118' + aleatorio(), senha: 'senha-e2e-' + aleatorio()
+  });
+  assert.ok(reg.token, 'token devolvido');
+  localStorage.setItem('jwt', reg.token);
+
+  const antes = await Api.estatisticas();
+  const d = await Api.denunciar({
+    telefoneGolpista: `(${golpista.slice(0, 2)}) ${golpista.slice(2, 7)}-${golpista.slice(7)}`,
+    canal: 'WHATSAPP', estabelecimentoFalsificado: 'Loja E2E', descricao: relato
+  });
+  assert.ok(d.id, 'denúncia com id gerado pelo banco');
+  assert.equal(d.descricao, relato);
+  idDenuncia = d.id;
+
+  const depois = await Api.estatisticas();
+  assert.equal(depois.totalDenuncias, antes.totalDenuncias + 1, 'total de denúncias aumentou 1 no banco');
+});
+
+test('a consulta pública já enxerga a denúncia gravada', { skip: pular }, async () => {
+  const r = await Api.telefone(golpista);
+  assert.notEqual(r.nivelRisco, 'BAIXO', 'o número denunciado não pode continuar como risco baixo');
+});
+
+test('admin lê a denúncia direto da base', { skip: pular || (!process.env.ADMIN_EMAIL && 'defina ADMIN_EMAIL e ADMIN_SENHA') }, async () => {
+  const login = await Api.login({ email: process.env.ADMIN_EMAIL, senha: process.env.ADMIN_SENHA });
+  assert.equal(login.cliente.perfil, 'ADMIN');
+  localStorage.setItem('jwt', login.token);
+  const todas = await Api.denuncias();
+  const gravada = todas.find(x => x.id === idDenuncia);
+  assert.ok(gravada, 'denúncia encontrada na listagem do admin');
+  assert.equal(gravada.descricao, relato);
+  assert.equal(gravada.estabelecimentoFalsificado, 'Loja E2E');
+});
diff --git a/tests/frontend/denunciar.test.mjs b/tests/frontend/denunciar.test.mjs
new file mode 100644
index 0000000..ffd19c0
--- /dev/null
+++ b/tests/frontend/denunciar.test.mjs
@@ -0,0 +1,88 @@
+/**
+ * Aba "Denunciar golpe": botão da Delegacia Digital e o envio da denúncia
+ * (o que o front manda para a API e como reage à resposta).
+ */
+import { test, beforeEach } from 'node:test';
+import assert from 'node:assert/strict';
+import { montarNavegador, frontModule, aguardar } from '../helpers/dom.mjs';
+
+let resposta = { status: 201, body: { id: 1 } };
+const { document, chamadas } = montarNavegador({
+  sessao: { id: 7, nome: 'Pessoa Teste', email: 't@t.com', perfil: 'USUARIO' },
+  rotas: (metodo, caminho) => {
+    if (metodo === 'POST' && caminho === '/denuncias') return resposta;
+    if (caminho === '/prevencao/checklist') return { body: { se_ja_pagou: ['Ligue para o banco.'] } };
+    if (caminho === '/denuncias/estatisticas') return { body: { limiteConfirmacao: 3 } };
+    return { status: 404, body: {} };
+  }
+});
+const { bindMasks } = await import(frontModule('js/util.js'));
+const denunciar = await import(frontModule('js/views/denunciar.js'));
+bindMasks();
+denunciar.init();
+denunciar.show({});
+
+const $ = s => document.querySelector(s);
+function preencher(campos) {
+  for (const [id, valor] of Object.entries(campos)) {
+    const el = $(id);
+    el.value = valor;
+    el.dispatchEvent(new document.defaultView.Event('input'));
+  }
+}
+beforeEach(() => { chamadas.length = 0; resposta = { status: 201, body: { id: 1 } }; });
+
+test('botão leva para a Delegacia Digital da Polícia Civil de SP, em nova aba', () => {
+  const link = $('#v-denunciar a#dDelegacia');
+  assert.ok(link, 'o botão existe dentro da aba Denunciar');
+  assert.equal(link.getAttribute('href'), 'https://delegaciadigital.policia-civil.sp.gov.br/pagina-inicial');
+  assert.equal(link.getAttribute('target'), '_blank');
+  assert.match(link.getAttribute('rel'), /noopener/);
+  assert.match(link.textContent, /Delegacia Digital/);
+});
+
+test('envia a denúncia para POST /denuncias com token e o corpo que a API espera', async () => {
+  preencher({ '#dTel': '11987654321', '#dLoja': 'Floricultura Bela Flor', '#dVa': '9,90', '#dVc': '990', '#dDesc': 'Cobrou na maquininha.' });
+  $('#dCanal').value = 'ENTREGADOR_PRESENCIAL';
+  $('#fDenuncia').requestSubmit();
+  await aguardar();
+
+  const post = chamadas.find(c => c.metodo === 'POST');
+  assert.ok(post, 'fez a requisição');
+  assert.equal(post.url, 'http://api.teste/denuncias');
+  assert.equal(post.headers.Authorization, 'Bearer token-de-teste');
+  assert.equal(post.headers['Content-Type'], 'application/json');
+  assert.deepEqual(post.corpo, {
+    telefoneGolpista: '(11) 98765-4321',
+    canal: 'ENTREGADOR_PRESENCIAL',
+    estabelecimentoFalsificado: 'Floricultura Bela Flor',
+    descricao: 'Cobrou na maquininha. [Valor anunciado: R$ 9,90 | cobrado: R$ 990]'
+  });
+  assert.match($('#dMsg').textContent, /Denúncia enviada/);
+  assert.equal($('#dTel').value, '', 'formulário limpo depois do sucesso');
+});
+
+test('campos opcionais vazios vão como null', async () => {
+  preencher({ '#dTel': '11987654321' });
+  $('#fDenuncia').requestSubmit();
+  await aguardar();
+  const post = chamadas.find(c => c.metodo === 'POST');
+  assert.equal(post.corpo.estabelecimentoFalsificado, null);
+  assert.equal(post.corpo.descricao, null);
+});
+
+test('mostra a mensagem de erro que a API devolve (ex.: 409 denúncia repetida)', async () => {
+  resposta = { status: 409, body: { erro: 'Você já denunciou este número.' } };
+  preencher({ '#dTel': '11987654321' });
+  $('#fDenuncia').requestSubmit();
+  await aguardar();
+  assert.match($('#dMsg').textContent, /Você já denunciou este número/);
+  assert.equal($('#dTel').value, '(11) 98765-4321', 'mantém o que a pessoa digitou');
+});
+
+test('telefone inválido não chega a chamar a API', async () => {
+  preencher({ '#dTel': '1198' });
+  $('#fDenuncia').requestSubmit();
+  await aguardar();
+  assert.equal(chamadas.filter(c => c.metodo === 'POST').length, 0);
+});
